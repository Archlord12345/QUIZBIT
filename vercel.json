{
  "version": 2,
  "name": "quizbit-admin",
  "installCommand": "npm ci --prefix vercel",
  "buildCommand": "npm run build --prefix vercel",
  "outputDirectory": "vercel/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 120,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?path=:path*"
    }
  ]
}
