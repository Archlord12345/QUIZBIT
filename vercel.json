{
  "version": 2,
  "name": "quizbit-admin",
  "builds": [
    { "src": "vercel/package.json", "use": "@vercel/static-build" },
    { "src": "vercel/api/**/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/vercel/api/$1" },
    { "src": "/(.*)", "dest": "/vercel/$1" }
  ]
}
